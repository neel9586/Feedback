JWT_SECRET=super_secret_jwt_key_student_feedback_2026_x89a

# ========================================================
# OPTION 1: Zero-Config Vercel Demo (SQLite Fallback)
# ========================================================
# No database configuration needed! The system will automatically
# initialize a SQLite database in /tmp and seed the default accounts:
#   Admin: admin@college.edu / admin123
#   Student: neel.student@college.edu / student123

# ========================================================
# OPTION 2: Persistent Cloud MySQL (TiDB Cloud / Aiven / Railway)
# ========================================================
# Set these in Vercel Dashboard -> Project -> Settings -> Environment Variables:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_USER=your_tidb_user
# DB_PASSWORD=your_tidb_password
# DB_NAME=student_feedback_db
# DB_PORT=4000
# DB_SSL=true
# USE_MYSQL=true
